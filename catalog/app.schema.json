{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/garfbargle/library/catalog/app.schema.json",
  "title": "Library app manifest v2",
  "type": "object",
  "required": ["id", "name", "packageName", "developer", "tagline", "description", "category", "release", "provenance"],
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["name", "sha256", "sizeBytes", "abis", "authRequired"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "downloadUrl": {"type": ["string", "null"]},
        "apiUrl": {"type": ["string", "null"]},
        "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "sizeBytes": {"type": "integer", "minimum": 0},
        "abis": {"type": "array", "items": {"type": "string"}},
        "authRequired": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "installableRelease": {
      "type": "object",
      "required": ["versionName", "versionCode", "minSdk", "targetSdk", "artifacts"],
      "properties": {
        "tag": {"type": ["string", "null"]},
        "versionName": {"type": "string"},
        "versionCode": {"type": "integer", "minimum": 0},
        "minSdk": {"type": "integer", "minimum": 1},
        "targetSdk": {"type": "integer", "minimum": 1},
        "publishedAt": {"type": ["string", "null"]},
        "releaseUrl": {"type": ["string", "null"]},
        "signingCertSha256": {"type": ["string", "null"], "pattern": "^[0-9A-Fa-f:]{64,95}$"},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "changelog": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "packageName": {"type": "string", "minLength": 3},
    "developer": {"type": "string"},
    "tagline": {"type": "string"},
    "description": {"type": "string"},
    "icon": {
      "type": ["object", "null"],
      "required": ["mimeType", "dataBase64"],
      "properties": {
        "mimeType": {"enum": ["image/png", "image/webp", "image/jpeg"]},
        "dataBase64": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "category": {"type": "string"},
    "accent": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "featured": {"type": "boolean"},
    "visibility": {"enum": ["public", "private"]},
    "repository": {"type": ["string", "null"]},
    "sourceUrl": {"type": ["string", "null"]},
    "release": {"$ref": "#/$defs/installableRelease"},
    "releases": {"type": "array", "items": {"$ref": "#/$defs/installableRelease"}},
    "provenance": {"type": "object", "required": ["kind"]},
    "changelog": {"type": "array", "items": {"type": "string"}},
    "history": {"type": "array"}
  }
}
